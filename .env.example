# Copy to .env and fill in.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# MySQL (production / shared dev). Leave unset to use a local SQLite file.
# DATABASE_URL=mysql+pymysql://skillproof:password@localhost:3306/skillproof?charset=utf8mb4

# Where evidence files are stored (outside the public static folder)
# UPLOAD_FOLDER=/var/lib/skillproof/uploads

# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=1

# Email (confirmation & password reset). Without SMTP_HOST, links are printed to the
# console and shown on screen (set SHOW_DEV_LINKS=0 to hide them).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=SkillProof <no-reply@example.com>

# AI onboarding assistant (optional). Without a key the assistant runs in offline guide mode.
# ANTHROPIC_API_KEY=sk-ant-...
# SKILLPROOF_AI_MODEL=claude-opus-5-5
# SKILLPROOF_AI=on
